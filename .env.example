# Copia para .env (ou corre ./scripts/init-env.sh, que gera os segredos).

# --- Bot -----------------------------------------------------------------
BOT_NAME=este projeto
BOT_CONTACT=
# SYSTEM_PROMPT=  (opcional: substitui o prompt gerado a partir de BOT_NAME/BOT_CONTACT)
UI_TITLE=Chatbot
UI_INTRO=Pergunta sobre este projeto.
UI_SUGGESTIONS=Que modelo usa?|Que hardware é preciso?|Como funciona a resposta?

# --- Knowledge base ------------------------------------------------------
# folder (ficheiros .md/.txt em ./knowledge) | sitemap | modulo:funcao
KB_SOURCE=folder
KB_SITEMAP_URL=
# Regex do que nunca deve chegar ao público, p.ex. endereços internos:
KB_STRIP_PATTERN=
KB_MAX_CHARS=1600

# --- Modelo (llama.cpp) --------------------------------------------------
LLM_HF_MODEL=unsloth/Qwen3-1.7B-GGUF:Q4_K_M
LLM_MODEL_NAME=qwen3-1.7b
LLM_CONTEXT=6144
LLM_PARALLEL=2
MAX_ANSWER_TOKENS=250
MAX_HISTORY_TOKENS=800

# --- Portas (só localhost por defeito; publica com um reverse proxy) -----
CHAT_BIND=127.0.0.1
CHAT_PORT=8000
LANGFUSE_PORT=3000

# --- Langfuse (opcional) -------------------------------------------------
# Para ligar: COMPOSE_PROFILES=langfuse e LANGFUSE_HOST=http://langfuse-web:3000
COMPOSE_PROFILES=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ADMIN_EMAIL=admin@langfuse.local
LANGFUSE_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
